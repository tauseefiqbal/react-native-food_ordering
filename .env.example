# ==============================================================================
# Food Delivery App - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` and fill in your actual credentials:
#   cp .env.example .env
#
# In Expo, environment variables prefixed with `EXPO_PUBLIC_` are exposed
# to client-side code during bundling.
# ==============================================================================

# ------------------------------------------------------------------------------
# Appwrite Backend Configuration (Required)
# ------------------------------------------------------------------------------
# Your Appwrite Project ID (Found in Appwrite Console -> Project Settings)
EXPO_PUBLIC_APPWRITE_PROJECT_ID=

# Appwrite API Endpoint
# Default cloud endpoint: https://cloud.appwrite.io/v1
# Frankfurt cloud endpoint: https://fra.cloud.appwrite.io/v1
# Self-hosted: http://<your-ip-or-domain>/v1
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# ------------------------------------------------------------------------------
# Appwrite Platform & Identifiers (Optional / Custom Deployments)
# ------------------------------------------------------------------------------
# The client platform package / bundle ID registered under Appwrite Platforms
EXPO_PUBLIC_APPWRITE_PLATFORM=com.ti.foodordering

# Appwrite Database & Storage Bucket IDs
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_BUCKET_ID=

# Appwrite Collection IDs
EXPO_PUBLIC_APPWRITE_USER_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_CATEGORIES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_MENU_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_CUSTOMIZATIONS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_MENU_CUSTOMIZATIONS_COLLECTION_ID=

# Stripe Payment Configuration
# ------------------------------------------------------------------------------
# Safe to expose publicly on the client. Used to initialize the Stripe UI.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Appwrite Function ID of the "payments-with-stripe" function (functions/payments-with-stripe).
# Found in Appwrite Console -> Functions -> payments-with-stripe -> Settings.
EXPO_PUBLIC_APPWRITE_STRIPE_FUNCTION_ID=

# ------------------------------------------------------------------------------
# Server-side only: set these on the Appwrite Function (Settings -> Environment
# variables), NOT in this file's EXPO_PUBLIC_ section. Never ship them in the app.
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# FUNCTION_PUBLIC_URL=https://<your-function-domain>.appwrite.run
# APPWRITE_DATABASE_ID=<database holding the orders collection>
# APPWRITE_COLLECTION_ID=<orders collection id>
# MENU_DATABASE_ID=<database holding menu + customizations; defaults to APPWRITE_DATABASE_ID>
# MENU_COLLECTION_ID=<menu collection id>
# CUSTOMIZATIONS_COLLECTION_ID=<customizations collection id>
